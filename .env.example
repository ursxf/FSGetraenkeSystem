# Kopiere diese Datei als .env und passe die Werte an:
#   Windows CMD:        copy .env.example .env
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux/macOS:        cp .env.example .env

# Flask Secret Key (beliebige zufällige Zeichenkette)
SECRET_KEY=change-me-before-using-in-production

# Datenbank (Standard: SQLite-Datei im Projektordner)
DATABASE_URL=sqlite:///getraenke.db

# Admin-Zugangsdaten
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# RFID-Hardware: auf true setzen, wenn ein RC522-Lesegerät angeschlossen ist
# Auf false lassen für Demo-Modus ohne Hardware (Windows-Test)
RFID_ENABLED=false
