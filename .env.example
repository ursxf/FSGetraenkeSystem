# =============================================================================
#  FSGetraenkeSystem – Beispiel-Konfiguration
#  Kopiere diese Datei nach ".env" und passe die Werte an.
#  Variablen können alternativ direkt als Umgebungsvariablen gesetzt werden.
# =============================================================================


# -----------------------------------------------------------------------------
# Flask / Sicherheit
# -----------------------------------------------------------------------------

# Geheimschlüssel für verschlüsselte Sessions – MUSS in Produktion gesetzt
# werden. Wert erzeugen z. B. mit: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production


# -----------------------------------------------------------------------------
# Datenbank
# -----------------------------------------------------------------------------

# SQLite (Standard, keine weitere Einrichtung nötig):
DATABASE_URL=sqlite:///getraenke.db

# PostgreSQL-Beispiel (für Produktiv-Einsatz):
# DATABASE_URL=postgresql://user:password@localhost:5432/getraenke


# -----------------------------------------------------------------------------
# Erster Admin-Account
# Wird nur beim allerersten Start verwendet, um den initialen Admin anzulegen.
# Danach können weitere Admins über das Admin-Panel verwaltet werden.
# -----------------------------------------------------------------------------

ADMIN_USERNAME=admin

# Wenn leer, wird beim ersten Start ein zufälliges Passwort generiert und
# einmalig in der Konsole ausgegeben.
ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# RFID-Modus
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  DEMO-MODUS  (Standard – kein Lesegerät erforderlich)                  │
# │                                                                         │
# │  RFID_ENABLED=false                                                     │
# │                                                                         │
# │  • Im Kiosk wird ein Eingabefeld angezeigt, in das eine beliebige       │
# │    RFID-UID manuell eingetippt werden kann.                             │
# │  • Optional: RFID_DEMO_UID setzen, damit das Kiosk diese UID           │
# │    automatisch verwendet – praktisch für Vorführungen und Tests.        │
# └─────────────────────────────────────────────────────────────────────────┘
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  PRODUKTIV-MODUS  (Raspberry Pi mit RC522-Lesegerät)                   │
# │                                                                         │
# │  RFID_ENABLED=true                                                      │
# │                                                                         │
# │  • Liest echte Karten vom angeschlossenen RC522-Modul.                 │
# │  • Voraussetzungen: pip install mfrc522  +  SPI aktiviert (raspi-config)│
# │  • RFID_DEMO_UID wird in diesem Modus ignoriert.                       │
# └─────────────────────────────────────────────────────────────────────────┘
# -----------------------------------------------------------------------------

RFID_ENABLED=false

# Nur im Demo-Modus: feste UID, die automatisch verwendet wird.
# Leer lassen → manuelle Eingabe im Kiosk-Formular.
RFID_DEMO_UID=
